#!/bin/sh
#
# T3 Gemstone O1 (AM67 R5F) boot - deliberately LINEAR:
# no variables, no nesting, no airframe indirection. This NSH build
# chokes on px4fmu_common's rcS ($VARS expansion crash); every line
# below is independently proven on this hardware.
#
set +e

# RAM-only params (no SD/MTD): re-applied every boot
param set SYS_AUTOSTART 4001
# No barometer yet: the fitted part does not match the schematic's LPS22DF.
# Height comes from GPS until a barometer is added.
param set SYS_HAS_BARO 0
param set SYS_HAS_GPS 1
param set EKF2_BARO_CTRL 0
param set EKF2_HGT_REF 1

# Airframe 4001 (Quad X), copied from airframes/4001_quad_x and rc.mc_defaults
# because this rcS does not run rc.autostart. Without these CA_ROTOR_COUNT
# stays 0 and the control allocator drives no motor at all.
# IMU_GYRO_RATEMAX stays at 400 Hz: the EPWM frame is 400 Hz, so a faster
# rate loop could not reach the ESCs any sooner.
param set-default MAV_TYPE 2
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 1
param set-default CA_ROTOR0_PY 1
param set-default CA_ROTOR1_PX -1
param set-default CA_ROTOR1_PY -1
param set-default CA_ROTOR2_PX 1
param set-default CA_ROTOR2_PY -1
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_PX -1
param set-default CA_ROTOR3_PY 1
param set-default CA_ROTOR3_KM -0.05
param set-default RTL_RETURN_ALT 30
param set-default RTL_DESCEND_ALT 10
# Outputs: ch1..4 (EPWM0_A/B, EPWM1_A/B) = Motor1..4, ch5 (eCAP1) unused.
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default PWM_MAIN_FUNC5 0

# No persistent storage yet: keep missions and the geofence in RAM so they
# work within a boot instead of failing on a file that cannot be written.
dataman start -r
# ICM-20948 sits on the bottom side. Body +X follows the X arrow printed
# next to it, which gives ROTATION_ROLL_180 (8) for accel, gyro and the
# AK09916 magnetometer.
icm20948 -s -b 1 -c 3 -M -R 8 start
sensors start

# GPS on MAIN_UART6 (/dev/ttyS1, HAT 7 RX / 11 TX). No -b: the driver scans
# the baud rate and moves a u-blox M8+ to 115200 itself. Forcing 9600 kept a
# 10 Hz UBX stream on a 9600 baud link, which overflows it.
gps start -d /dev/ttyS1
ekf2 start
commander start
mc_rate_control start
mc_att_control start
mc_pos_control start
mc_hover_thrust_estimator start
control_allocator start
pwm_out start
land_detector start multicopter
rc_update start
manual_control start
navigator start

# transport to Linux/QGC last; TX flows once the bridge primes the channel
mavlink start -d /dev/tty
