#!/bin/sh
#
# T3 Gemstone O1 defaults. A value changed from QGC is stored and wins.
#

# Quad X until another airframe is chosen in QGC.
param set-default SYS_AUTOSTART 4001

# Barometer defaults are set in rc.board_sensors, once it is known whether
# the LPS22DF answers.
param set-default SYS_HAS_GPS 1

# Ground station link loss: Return (the MAVLink link through Linux is the
# only control link until an RC link is added).
param set-default NAV_DLL_ACT 2

# Outputs: ch1..4 (EPWM0_A/B, EPWM1_A/B) = Motor1..4, ch5 (eCAP1) unused.
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default PWM_MAIN_FUNC5 0

# The board measures no supply rail (no ADC, no power module yet), so the
# "system power" preflight check can never pass. Circuit breaker, PX4's
# documented value; remove it once a power measurement exists (TODO F1.9).
param set-default CBRK_SUPPLY_CHK 894281

# ULog buffer in kB (plenty of RAM on this core).
set LOGGER_BUF 64
